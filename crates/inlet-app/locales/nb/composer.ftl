# Meldingsfeltet.

composer-placeholder-empty = Send melding
composer-placeholder = Send melding til { $channel }
composer-too-long = Meldingen kan ikke være lengre enn { $max } tegn.

## Overskrifter i autofullføring og beskrivelser av kommandoer

composer-ac-mentions = Medlemmer og roller
composer-ac-channels = Kanaler
composer-ac-emoji = Emoji
composer-ac-commands = Kommandoer
composer-cmd-shrug = Legger til ¯\_(ツ)_/¯ i meldingen din.
composer-cmd-tableflip = Legger til (╯°□°)╯︵ ┻━┻ i meldingen din.
composer-cmd-unflip = Legger til ┬─┬ ノ( ゜-゜ノ) i meldingen din.
composer-cmd-me = Send en handlingsmelding (vises i kursiv).
composer-cmd-spoiler = Send en spoilermelding (pakkes inn i spoilertagger).
composer-cmd-nick = Endre kallenavnet ditt i dette fellesskapet.
composer-cmd-msg = Send en direktemelding til en bruker.
composer-cmd-saved = Send et lagret medieelement.

## Kommandoer som kaller serveren

composer-nick-changed = Kallenavnet ditt i dette fellesskapet er nå { $nick }.
composer-nick-reset = Kallenavnet ditt i dette fellesskapet er fjernet.
composer-nick-guild-only = Kallenavn kan bare endres i et fellesskap.
composer-msg-sent = Direktemeldingen er sendt.
composer-msg-failed = Kunne ikke sende direktemeldingen: { $error }
composer-command-failed = Kommandoen mislyktes: { $error }
composer-bad-answer = serveren ga et svar Inlet ikke kunne lese
composer-not-connected = ikke koblet til serveren

## Svarlinjen

composer-replying-to = Svarer til
composer-reply-mention-on = @ På
composer-reply-mention-off = @ Av
composer-reply-close = ✕

## Redigere en melding

composer-edit-title = escape for å
composer-edit-enter = • enter for å
composer-edit-cancel = avbryte
composer-edit-save = lagre
composer-edit-failed = Kunne ikke redigere meldingen: { $error }

## Sakte modus

composer-slowmode-on = Sakte modus er på
composer-slowmode-wait = Sakte modus: { $time }
composer-slowmode-immune = Sakte modus gjelder ikke for deg

## Vedlegg

composer-attach-plus = +
composer-attach-prompt = Legg ved
composer-attach-remove = ✕
composer-attach-spoiler = Spoiler
composer-attach-spoiler-on = SPOILER
composer-attach-alt = ALT
composer-attach-alt-title = Alternativ tekst for { $name }
composer-attach-alt-placeholder = Beskriv filen for folk som ikke kan se den
composer-attach-alt-hint = enter for å lagre • escape for å avbryte
composer-attach-check = ✓
composer-attach-strip-exif = Fjern stedsdata og kameradata fra bilder før opplasting
composer-demo-alt = Et blått rektangel
composer-pending-files = 📎 { $names }
composer-upload-too-many = En melding kan ha høyst { $max } filer.
composer-upload-too-large = { $name } er større enn { $max }, som er grensen for denne kontoen.
composer-upload-too-much = Disse filene er til sammen større enn { $max }, som er grensen for én melding.
composer-upload-not-a-file = { $name } er ikke en fil og ble ikke lagt ved.
composer-upload-unreadable = filen kunne ikke leses
composer-upload-file-changed = filen ble endret eller kunne ikke leses etter at den ble lagt ved
composer-upload-gone = filene beholdes ikke lenger; legg dem ved på nytt
composer-upload-progress = { $sent } av { $total }
composer-upload-names-more = { $first } og { $more } til
composer-upload-cancel = Avbryt
composer-upload-switched = Opplastingen stoppet fordi du byttet konto. Meldingen din er beholdt som utkast.
composer-upload-draft-files = (legg ved på nytt: { $names })
composer-upload-metadata-failed = stedsdataene kunne ikke fjernes fra { $name }; fjern filen, eller velg å sende den uten å fjerne dem
composer-paste-unreadable = Det innlimte bildet kunne ikke leses.
composer-paste-unsupported = Denne typen bilde kan ikke limes inn. Lagre det som PNG eller JPEG og legg ved filen.
composer-paste-too-large = Det innlimte bildet er for stort til å legges ved.
composer-attach-no-permission = Du kan ikke legge ved filer i denne kanalen.
composer-attach-metadata-stuck = Stedsdata kunne ikke fjernes.
composer-attach-metadata-kept = Sendt med stedsdata.
composer-attach-send-anyway = Send uten å fjerne
composer-attach-metadata-undo = Angre
composer-attach-metadata-blocked = Stedsdataene kunne ikke fjernes fra { $name }. Fjern filen, eller velg «Send uten å fjerne» på den.
composer-upload-was-sent = Den meldingen ble sendt likevel, så utkastet ble fjernet.
