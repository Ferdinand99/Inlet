# «Bekreft at det er deg»: dialogen før en handling Fluxer beskytter (sletting av kontoen,
# bytte av passord, tofaktor på eller av, ...).

sudo-title = Bekreft at det er deg
sudo-body = Av sikkerhetshensyn må du bekrefte at det er deg for å fortsette.
sudo-password-label = Passord
sudo-password-placeholder = Passordet ditt
sudo-code-label = Kode fra autentiseringsappen eller reservekode
sudo-code-placeholder = Kode med 6 sifre eller reservekode
sudo-use-code = Bruk en kode i stedet
sudo-use-password = Bruk passordet mitt i stedet
sudo-confirm = Bekreft
sudo-working = Sjekker …
sudo-wrong-password = Passordet er ikke riktig.
sudo-no-password = Kontoen har ikke noe passord. Bruk en kode i stedet.
sudo-wrong-code = Koden er ikke riktig. Prøv en annen.
sudo-not-accepted = Det ble ikke godtatt.
sudo-locked = For mange feil forsøk. Prøv igjen om { $minutes } min.
sudo-failed = { $reason }
sudo-unsupported = Kontoen bekrefter med en passnøkkel, en kode på e-post eller enkel pålogging, og det kan ikke Inlet ennå. Bruk Fluxer i nettleseren for dette.
