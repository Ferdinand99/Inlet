# Samtalekolonnen: meldinger og linjene over listen.

message-show-more = Vis mer
message-no-text = (ingen tekst)
message-bot-tag = BOT
chat-channel-not-on-screen = Den kanalen finnes ikke i listen på skjermen.
chat-dismissable = { $text }  (klikk for å lukke)
chat-disconnected = Frakoblet. { $message }
chat-reconnect = Koble til på nytt
message-system-tag = SYSTEM
message-op-tag = OP
message-send-failed = Kunne ikke sende: { $reason }
message-retry = Prøv igjen
chat-reply-not-loaded = Den opprinnelige meldingen er ikke lastet inn.
chat-new-mark = NY
chat-new-message = 1 ny melding siden { $since }
chat-new-messages = { $count } nye meldinger siden { $since }
chat-new-messages-many = { $count }+ nye meldinger siden { $since }
chat-mark-as-read = Merk som lest
chat-jump-to-present = Gå til de nyeste meldingene
chat-jump-new-message = 1 ny melding – gå til de nyeste
chat-jump-new-messages = { $count } nye meldinger – gå til de nyeste
reply-deleted = Opprinnelig melding ble slettet
reply-unknown = Den opprinnelige meldingen kunne ikke lastes inn

# Starten på en kanal.
welcome-channel-title = Velkommen til #{ $channel }!
welcome-channel = Dette er starten på kanalen #{ $channel }.
welcome-dm = Dette er starten på direktemeldingshistorikken din med { $name }.
welcome-group = Velkommen til starten på denne gruppen.

# Systemmeldinger. Navn renses før de settes inn.
system-join = { $name } ble med i fellesskapet.
system-pinned = { $name } festet en melding i denne kanalen.
system-recipient-add = { $name } la til { $target } i gruppen.
system-recipient-remove = { $name } fjernet { $target } fra gruppen.
system-recipient-left = { $name } forlot gruppen.
system-call = { $name } startet en samtale.
system-channel-name = { $name } endret kanalnavnet: { $channel }
system-channel-icon = { $name } endret kanalikonet.
system-follow-add = { $name } la til { $channel } i denne kanalen. De viktigste oppdateringene derfra vises her.
system-thread-created = { $name } startet en tråd: { $thread }
system-thread-starter = Denne tråden startet fra en melding.
system-unknown = Denne meldingstypen støttes ikke ennå.

# Tidspunkter for meldinger. Rekkefølgen på dag, måned og år følger systemets språkinnstilling.
time-am = { $time } AM
time-pm = { $time } PM
time-date-and-time = { $date }, { $time }
