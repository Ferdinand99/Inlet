# Markdown i meldinger.

markdown-edited = (redigert)
markdown-invalid-link = ugyldig lenke
markdown-unknown-channel = #ukjent-kanal
markdown-unknown-user = ukjent-bruker
markdown-unknown-role = Ukjent rolle

markdown-everyone = @everyone
markdown-here = @here
markdown-alert-note = Notat
markdown-alert-tip = Tips
markdown-alert-important = Viktig
markdown-alert-warning = Advarsel
markdown-alert-caution = Forsiktig
markdown-nav-customize = <id:customize>
markdown-nav-browse = <id:browse>
markdown-nav-guide = <id:guide>
markdown-nav-linked-roles = <id:linked-roles>
markdown-nav-linked-roles-id = <id:linked-roles:{ $id }>
markdown-math = matte
markdown-table-cut = Tabellen er kortet ned: Bare de første radene og kolonnene vises.

# Tidsstempler (<t:…>). Datoer følger rekkefølgen som er vanlig på systemet.
markdown-month-1 = januar
markdown-month-2 = februar
markdown-month-3 = mars
markdown-month-4 = april
markdown-month-5 = mai
markdown-month-6 = juni
markdown-month-7 = juli
markdown-month-8 = august
markdown-month-9 = september
markdown-month-10 = oktober
markdown-month-11 = november
markdown-month-12 = desember
markdown-weekday-1 = mandag
markdown-weekday-2 = tirsdag
markdown-weekday-3 = onsdag
markdown-weekday-4 = torsdag
markdown-weekday-5 = fredag
markdown-weekday-6 = lørdag
markdown-weekday-7 = søndag
markdown-date-long-mdy = { $month } { $day }, { $year }
markdown-date-long-dmy = { $day }. { $month } { $year }
markdown-date-at-time = { $date } kl. { $time }
markdown-weekday-and-date = { $weekday } { $date }

# Relative tidsstempler (<t:…:R>), som Intl.RelativeTimeFormat med numeric "auto".
# Variantene med -one er for tallet 1.
markdown-time-now = nå
markdown-time-seconds-future-one = om 1 sekund
markdown-time-seconds-future = om { $count } sekunder
markdown-time-seconds-past-one = for 1 sekund siden
markdown-time-seconds-past = for { $count } sekunder siden
markdown-time-minutes-future-one = om 1 minutt
markdown-time-minutes-future = om { $count } minutter
markdown-time-minutes-past-one = for 1 minutt siden
markdown-time-minutes-past = for { $count } minutter siden
markdown-time-hours-future-one = om 1 time
markdown-time-hours-future = om { $count } timer
markdown-time-hours-past-one = for 1 time siden
markdown-time-hours-past = for { $count } timer siden
markdown-time-days-future-one = i morgen
markdown-time-days-future = om { $count } dager
markdown-time-days-past-one = i går
markdown-time-days-past = for { $count } dager siden
markdown-time-weeks-future-one = neste uke
markdown-time-weeks-future = om { $count } uker
markdown-time-weeks-past-one = forrige uke
markdown-time-weeks-past = for { $count } uker siden
markdown-time-months-future-one = neste måned
markdown-time-months-future = om { $count } måneder
markdown-time-months-past-one = forrige måned
markdown-time-months-past = for { $count } måneder siden
markdown-time-years-future-one = neste år
markdown-time-years-future = om { $count } år
markdown-time-years-past-one = i fjor
markdown-time-years-past = for { $count } år siden
