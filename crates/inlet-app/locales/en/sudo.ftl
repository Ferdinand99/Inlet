# "Confirm it's you": the dialog before an action Fluxer protects (deleting the account,
# changing the password, turning two-factor on or off, ...).

sudo-title = Confirm it's you
sudo-body = For your security, confirm it's you to continue.
sudo-password-label = Password
sudo-password-placeholder = Your password
sudo-code-label = Authenticator or backup code
sudo-code-placeholder = 6-digit code or backup code
sudo-use-code = Use a code instead
sudo-use-password = Use my password instead
sudo-confirm = Confirm
sudo-working = Checking…
sudo-wrong-password = That password is not right.
sudo-no-password = This account has no password. Use a code instead.
sudo-wrong-code = That code is not right. Try another one.
sudo-not-accepted = That was not accepted.
sudo-locked = Too many wrong tries. Try again in { $minutes } min.
sudo-failed = { $reason }
sudo-unsupported = This account confirms with a passkey, an e-mailed code or single sign-on, and Inlet cannot do that yet. Use Fluxer in the browser for this.
