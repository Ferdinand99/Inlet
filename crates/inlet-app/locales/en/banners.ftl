# The banners across the top of the app, and the windows they open.

## The connection

banner-connection-lost = Connection lost. Reconnecting…
banner-try-again = Try again
banner-switch-account = Switch account
banner-view-incident = View incident details
banner-view-maintenance = View maintenance details

## The instance's notices and maintenance

banner-learn-more = Learn more
banner-maintenance-scheduled = Maintenance is scheduled for { $time }. Expected duration: { $duration }.
banner-maintenance-active = Maintenance is in progress. Expected duration: { $duration }.
banner-duration-minutes = { $count } { $count ->
    [one] minute
   *[other] minutes
}
banner-duration-hours = { $count } { $count ->
    [one] hour
   *[other] hours
}
banner-duration-days = { $count } { $count ->
    [one] day
   *[other] days
}

## The account

banner-verify-message = Hey { $name }, please confirm your email address.
banner-verify-bounced = Hey { $name }, we can't deliver email to your address. Add a working email to verify your account.
banner-resend-email = Resend email
banner-verify-sent = Verification email sent. Check your inbox.
banner-verify-wait = You've requested too many verification emails. Please wait a moment and try again.
banner-not-connected = Not connected to the server.
banner-limited-message = Messaging is paused on your account. Check your email for a quick step to continue.

## Updated terms

banner-terms-message = We've updated our policies. Review them to continue.
banner-review = Review
banner-close = Close
terms-title = Updated policies
terms-changed-terms = We've made significant changes to our terms of service. Review them before continuing to use { $product }.
terms-changed-privacy = We've made significant changes to our privacy policy. Review it before continuing to use { $product }.
terms-changed-both = We've made significant changes to our terms of service and privacy policy. Review them before continuing to use { $product }.
terms-link-terms = Terms of service
terms-link-privacy = Privacy policy
terms-agreement = By using { $product }, you agree to the updated terms.
terms-agree = I agree to the updated terms
terms-got-it = Got it

## A new domain

banner-domain-moved = { $product } has moved to { $host }. Add your account there to keep chatting.
banner-show-me-how = Show me how
moved-title = { $product } has a new address
moved-intro = { $product } is now at { $host }. To keep using it in Inlet, add your account again with the new address.
moved-step-add = Open the account switcher and choose Add an account.
moved-step-address = Enter { $host } as the instance.
moved-step-sign-in = Sign in, then sign out of the old account.
moved-copy-address = Copy address
