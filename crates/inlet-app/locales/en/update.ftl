# Automatic updates: the "Updates" section of the Desktop settings tab.

settings-update-heading = Updates
settings-update-auto = Download and install updates automatically
settings-update-auto-note = Inlet checks for a new beta every 6 hours, downloads it in the background and installs it the next time it starts.
settings-update-version = Installed version: { $version }
settings-update-unavailable = This copy of Inlet was not installed with the installer, so it cannot update itself.
settings-update-checking = Checking for updates...
settings-update-downloading = Downloading version { $version }: { $percent }%
settings-update-up-to-date = Inlet is up to date.
settings-update-ready = Version { $version } is ready. It is installed the next time Inlet starts.
settings-update-ready-off = Version { $version } is downloaded. It is installed when you restart Inlet, or the next time it starts if you turn automatic updates on.
settings-update-failed = The update check did not work: { $error }
settings-update-check = Check for updates
settings-update-restart = Restart to update
settings-update-notes = What's new in { $version }
