<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata for Inlet. The id is the app id (no.opland.inlet), the same as the
     desktop entry and the window's app id. build-flatpak.sh stamps the <release> entry with
     the version in Cargo.toml and the commit date before it packs the file. -->
<component type="desktop-application">
  <id>no.opland.inlet</id>

  <name>Inlet</name>
  <summary>Native desktop client for Fluxer</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <developer id="net.opland">
    <name>The Inlet contributors</name>
  </developer>

  <description>
    <p>
      Inlet is a native desktop client for Fluxer, the open-source chat platform. It is
      written in Rust and does not bundle a web browser.
    </p>
    <p>
      Inlet is in early beta and many features of the Fluxer web app are still missing.
      It is a separate project and is not made by the Fluxer team.
    </p>
    <ul>
      <li>Sign in to a Fluxer instance by its address</li>
      <li>Servers, channels and direct messages with live updates</li>
      <li>Fluxer's message formatting, embeds and attachments</li>
      <li>Desktop notifications, an unread badge and a tray icon</li>
    </ul>
  </description>

  <launchable type="desktop-id">no.opland.inlet.desktop</launchable>

  <url type="homepage">https://github.com/Ferdinand99/Inlet</url>
  <url type="bugtracker">https://github.com/Ferdinand99/Inlet/issues</url>
  <url type="vcs-browser">https://github.com/Ferdinand99/Inlet</url>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Ferdinand99/Inlet/v0/docs/images/inlet-windows.png</image>
      <caption>Inlet with the member list open, showing demo data</caption>
    </screenshot>
  </screenshots>

  <categories>
    <category>Network</category>
    <category>Chat</category>
  </categories>
  <keywords>
    <keyword>chat</keyword>
    <keyword>messenger</keyword>
    <keyword>fluxer</keyword>
  </keywords>

  <provides>
    <binary>inlet</binary>
  </provides>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>

  <releases>
    <release version="0.0.1" date="2026-11-17" type="development"/>
  </releases>
</component>
